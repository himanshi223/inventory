<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%=title%></title>
</head>
<body>
    <h1><%=title%></h1>
    <p><%=category%></p>
    <% if(locals.itemDetails){ %>
        <p>Quantity Left: <%=itemDetails.quantity%> <%=itemDetails.unit%></p>
    <% } else{ %>
        <p>Sorry no such item available</p>
    <% } %>
</body>
</html>