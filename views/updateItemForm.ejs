<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.title %></title>
</head>
<body>
    <h1><%= locals.title %></h1>
    <%- include("partials/errors.ejs") %>
    <form method="POST" action="./update">
        <div>
            <label for="item">Item Name</label>
            <input type="text" name="item" id="item" value="<%=locals.itemDetails.item%>" required/>
        </div>
        <div>
            <label for="quantity">Quantity</label>
            <input type="number" name="quantity" id="quantity" value="<%=locals.itemDetails.quantity%>" required/>
        </div>
        <div>
            <label for="unit">Measuring Unit</label>
            <input type="text" name="unit" id="unit" value="<%=locals.itemDetails.unit%>" required/>
        </div>
        <div>
            <label for="category">Category</label>
            <select name="category" id="category" required>
                <% categories.forEach((category)=>{%>
                    <% if(category.id === itemDetails.categoryid){%>
                        <option value="<%=category.id%>" selected><%=category.category%></option>
                    <% } %> 
                    else{
                        <option value="<%=category.id%>"><%=category.category%></option>
                    }
                <% }) %>
            </select>
            <a href="/categories/add">Add new category</a>
        </div>
        <button type="submit">Update Item</button>
    </form>
</body>
</html>